{
  "name": "isometric-map-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "generate:assets": "node scripts/buildAtlases.js",
    "generate:labyrinth": "esbuild scripts/generateLabyrinth.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/generateLabyrinth.mjs && node node_modules/.cache/generateLabyrinth.mjs",
    "generate:curse": "esbuild scripts/generateCursedRuins.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/generateCursedRuins.mjs && node node_modules/.cache/generateCursedRuins.mjs",
    "generate:valley": "esbuild scripts/generateValleyTD.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/generateValleyTD.mjs && node node_modules/.cache/generateValleyTD.mjs",
    "build":"node scripts/buildAtlases.js && vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource/cinzel": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.469.0",
    "node-turn": "^0.0.6",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "pinia": "^2.3.0",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "picomatch": "^4.0.7",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  }
}
