# Multiplayer server (server/index.js: PeerJS signaling + public room list).
# `npm run dev` and `npm start` host it together with the frontend, so leave this empty.
# Only set it when the frontend is deployed separately (e.g. static hosting) from the server:
VITE_SERVER_URL=

# Port `npm start` listens on (default 3000)
PORT=3000

# URL sub-path the app is served under (default: domain root), e.g. /Generator/
APP_BASE=/

# TURN relay (server/turn.js, started by `npm start`): carries the game between players whose networks block a
# direct WebRTC link (mobile data, CGNAT, strict NAT). Leave TURN_PUBLIC_IP empty to turn it off.
# Open in the firewall (Windows Firewall + the VPS panel): UDP TURN_PORT and UDP TURN_MIN_PORT-TURN_MAX_PORT.
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_USER=defensor
TURN_PASSWORD=

# Telegram Mini App (see README "Telegram Mini App"). All optional.
# The game's public https address: the bot's "Play" button opens it.
TELEGRAM_WEBAPP_URL=
# Bot token from @BotFather: the server then answers /start with a "Play" button and sets the bot's menu button.
TELEGRAM_BOT_TOKEN=
# Mini App link from @BotFather /newapp (https://t.me/<bot>/<app>): room invites open the game straight in the room.
TELEGRAM_APP_URL=

# Admin (server/admin.js): the one account that changes the game maps from the editor (save, add, copy, delete).
# The editor asks for this login and password. Without them `npm run dev` lets anyone change maps, `npm start` nobody.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Folder of the built-in map files (default: src/maps)
MAPS_DIR=
