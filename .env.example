# Multiplayer server (server/index.js: PeerJS signaling + public room list).
# `npm run dev` and `npm start` host it together with the frontend, so leave this empty.
# Only set it when the frontend is deployed separately (e.g. static hosting) from the server:
VITE_SERVER_URL=

# URL sub-path the app is served under (default: domain root), e.g. /Generator/
APP_BASE=/

# TURN relay (server/turn.js, started by `npm start`): carries the game between players whose networks block a
# direct WebRTC link (mobile data, CGNAT, strict NAT). Leave TURN_PUBLIC_IP empty to turn it off.
# Open in the firewall (Windows Firewall + the VPS panel): UDP TURN_PORT and UDP TURN_MIN_PORT-TURN_MAX_PORT.
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_USER=defensor
TURN_PASSWORD=
